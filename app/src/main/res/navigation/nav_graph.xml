<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/fragment_book_library">

    <fragment
        android:id="@+id/fragment_book_library"
        android:name="com.studylibrary.ui.library.BookLibraryFragment"
        android:label="Study Library"
        tools:layout="@layout/fragment_book_library">
        <action
            android:id="@+id/action_library_to_detail"
            app:destination="@id/fragment_book_detail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/fragment_book_detail"
        android:name="com.studylibrary.ui.detail.BookDetailFragment"
        android:label="Book Details"
        tools:layout="@layout/fragment_book_detail">
        <argument
            android:name="bookId"
            app:argType="string" />
        <action
            android:id="@+id/action_detail_to_reader"
            app:destination="@id/fragment_reader"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/fragment_reader"
        android:name="com.studylibrary.ui.reader.ReaderFragment"
        android:label="Reader"
        tools:layout="@layout/fragment_reader">
        <argument
            android:name="bookId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/fragment_favorites"
        android:name="com.studylibrary.ui.favorites.FavoritesFragment"
        android:label="Favorites"
        tools:layout="@layout/fragment_favorites" />

    <fragment
        android:id="@+id/fragment_downloads"
        android:name="com.studylibrary.ui.downloads.DownloadsFragment"
        android:label="Downloads"
        tools:layout="@layout/fragment_downloads" />

    <fragment
        android:id="@+id/fragment_settings"
        android:name="com.studylibrary.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
